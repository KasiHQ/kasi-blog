{
  "rewrites": [
    {
      "source": "/feed",
      "destination": "/api/feed"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/article/:slug",
      "destination": "/api/serve?slug=:slug"
    },
    {
      "source": "/((?!assets/|.*\\..*$).*)",
      "destination": "/index.html"
    }
  ]
}
